# ─── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_DB=crabsense
POSTGRES_USER=crabsense_user
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_PORT=5432

# ─── MinIO (HDF5 edge) ──────────────────────────────────────────────────────
MINIO_ACCESS_KEY=CHANGE_ME_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_SECRET_KEY
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ─── Media: image / video / log → Google Drive share ─────────────────────────
# Provider=Local (dev) | GoogleDrive (prod)
MEDIA_STORAGE_PROVIDER=GoogleDrive
GOOGLE_DRIVE_CREDENTIALS_PATH=secrets/google-drive-sa.json
# Folder ID trên Drive (share folder này cho email service account = Editor)
GOOGLE_DRIVE_SHARED_FOLDER_ID=PASTE_FOLDER_ID_HERE
# anyone = link công khai đọc được | private = chỉ người trong folder
GOOGLE_DRIVE_SHARE_MODE=anyone

# ─── API ────────────────────────────────────────────────────────────────────
API_PORT=8080
JWT_SECRET=CHANGE_ME_TO_A_VERY_LONG_SECRET_KEY_AT_LEAST_32_CHARACTERS_LONG
