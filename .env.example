# ─── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_DB=crabsense
POSTGRES_USER=crabsense_user
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# ─── MinIO (HDF5 edge) ──────────────────────────────────────────────────────
MINIO_ACCESS_KEY=CHANGE_ME_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_SECRET_KEY
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ─── Media: image / video / log ─────────────────────────────────────────────
# Local | GoogleDrive | s3
UPLOAD_STORAGE=s3
MEDIA_STORAGE_PROVIDER=s3

# ─── AWS S3 (crab photos) ───────────────────────────────────────────────────
S3_BUCKET=your-bucket
S3_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Google Drive (optional if UPLOAD_STORAGE=GoogleDrive) ──────────────────
GOOGLE_DRIVE_CREDENTIALS_PATH=secrets/google-drive-sa.json
GOOGLE_DRIVE_SHARED_FOLDER_ID=PASTE_FOLDER_ID_HERE
GOOGLE_DRIVE_SHARE_MODE=anyone

# ─── API ────────────────────────────────────────────────────────────────────
API_PORT=8080
JWT_SECRET=CHANGE_ME_TO_A_VERY_LONG_SECRET_KEY_AT_LEAST_32_CHARACTERS_LONG
